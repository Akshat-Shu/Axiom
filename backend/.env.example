# ============================================================
# Axiom — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# ------ OpenRouter LLM ----------------------------------------
# Paste your OpenRouter API key here:
OPENROUTER_API_KEY=sk-or-v1-PASTE_YOUR_KEY_HERE
OPENROUTER_MODEL=openai/gpt-4o-mini

# ------ Database ----------------------------------------------
DATABASE_URL=postgresql://axiom_user:axiom_pass@localhost:5432/axiom

# ------ Flask -------------------------------------------------
SECRET_KEY=change-me-to-a-random-secret
FLASK_ENV=development

# ------ AWS S3 ------------------------------------------------
# Bucket name — credentials are resolved automatically from the EC2 IAM role.
# Do NOT put AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY here on EC2.
S3_BUCKET_NAME=tt-bootcamp-axiom
AWS_REGION=us-east-1

# ------ Decay -------------------------------------------------
# Topics with a decay score above this threshold trigger proposals (0.0-1.0)
DECAY_THRESHOLD=0.7
